# =====================================================================
# NyayaConnect Monorepo Environment Configuration Template (.env.example)
# Person 4: Systems Integration & DevOps Standardized Port Allocations
# Copy this file to .env before starting services: cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# Phase 1 Standardized Port Configuration
# ---------------------------------------------------------------------
# Frontend (Next.js Application)
FRONTEND_PORT=3000
PORT=3000
NEXT_PUBLIC_PORT=3000

# Client API endpoint: Next.js embeds NEXT_PUBLIC_ variables into the browser bundle at build time.
# For local browser access talking to localhost backend: http://localhost:8000/api/v1
# For production deployments: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCKS=false

# Marketplace API Backend (FastAPI Service)
BACKEND_PORT=8000
PORT=8000
HOST=0.0.0.0

# RAG Service (ChromaDB + Constitutional AI Service)
RAG_PORT=8001

# Upstream RAG URL resolution:
# Inside Docker Compose network: http://rag_service:8001/api/v1
# When running backend directly on Windows host: http://127.0.0.1:8001/api/v1
RAG_SERVICE_URL=http://rag_service:8001/api/v1
RAG_LOCAL_URL=http://127.0.0.1:8001/api/v1

# ---------------------------------------------------------------------
# Relational Database Configuration (MySQL 8.0)
# ---------------------------------------------------------------------
# Host resolution:
# Inside Docker Compose network: DB_HOST=db
# When running backend directly on Windows host: DB_HOST=127.0.0.1 (or localhost)
DB_HOST=db
DB_PORT=3306
DB_USER=root
# Set a strong password in .env (Required by docker-compose)
DB_PASSWORD=change_me_to_a_secure_password
DB_DATABASE=nyayaconnect

# ---------------------------------------------------------------------
# Phase 2 Vernacular Voice-to-RAG Pipeline Configuration
# ---------------------------------------------------------------------
# Supported Indian Languages: kn-IN (Kannada), hi-IN (Hindi), ta-IN (Tamil), te-IN (Telugu), mr-IN (Marathi), bn-IN (Bengali), en-IN (Indian English)
DEFAULT_SOURCE_LANGUAGE=kn-IN

# Real Speech-to-Text & Translation API Keys
# Provide approved credentials for live STT and translation:
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
OPENAI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# ---------------------------------------------------------------------
# Phase 3 Docker & Cloud Infrastructure Settings
# ---------------------------------------------------------------------
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://nyayaconnect.vercel.app
CHROMA_PERSIST_DIRECTORY=/app/chroma_db
