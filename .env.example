# =====================================================================
# NyayaConnect Monorepo Environment Configuration (.env.example)
# Person 4: Systems Integration & DevOps Standardized Port Allocations
# =====================================================================

# ---------------------------------------------------------------------
# Phase 1 Standardized Port Configuration
# ---------------------------------------------------------------------
# Frontend (Next.js Application)
FRONTEND_PORT=3000
NEXT_PUBLIC_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCKS=false

# Marketplace API Backend (FastAPI Service)
BACKEND_PORT=8000
PORT=8000
HOST=0.0.0.0

# RAG Service (ChromaDB + Constitutional AI Service)
RAG_PORT=8001
RAG_SERVICE_URL=http://rag_service:8001/api/v1
# For local host outside Docker: http://localhost:8001/api/v1

# Relational Database Configuration (MySQL 8.0 / PostgreSQL)
DB_TYPE=mysql
DB_HOST=db
DB_PORT=3306
# Alternative PostgreSQL standard port: 5432
DB_USER=root
DB_PASSWORD=nyayaconnect_secret_pass
DB_DATABASE=nyayaconnect

# ---------------------------------------------------------------------
# Phase 2 Vernacular Voice-to-RAG Pipeline Configuration
# ---------------------------------------------------------------------
# Supported Indian Languages: kn-IN (Kannada), hi-IN (Hindi), ta-IN (Tamil), te-IN (Telugu), mr-IN (Marathi), bn-IN (Bengali), en-IN (Indian English)
DEFAULT_SOURCE_LANGUAGE=kn-IN
ENABLE_WEB_SPEECH_FALLBACK=true

# External Speech-to-Text & Translation API Keys (Optional Cloud Overrides)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
OPENAI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# ---------------------------------------------------------------------
# Phase 3 Docker & Cloud Infrastructure Settings
# ---------------------------------------------------------------------
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:3000,https://nyayaconnect.vercel.app,https://legal-advisor-fsd.vercel.app
CHROMA_PERSIST_DIRECTORY=/app/chroma_db
