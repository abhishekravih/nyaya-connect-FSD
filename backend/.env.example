# NyayaConnect Backend Environment Configuration
PORT=8000
ENVIRONMENT=development

# Database Connection URL
# Option 1: Local MySQL Workbench (Default MySQL port is 3306)
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/nyayaconnect_db

# Option 2: Cloud / Local PostgreSQL (Default PostgreSQL port is 5432)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nyayaconnect_db

# Option 3: Local SQLite fallback (Zero-configuration file-based database)
DATABASE_URL=sqlite:///./nyayaconnect.db

# JWT Security Credentials (HS256)
SECRET_KEY=nyayaconnect_backend_super_secret_dev_key_replace_for_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Person 1 Next.js Frontend & Person 3 RAG AI Service)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8001,http://127.0.0.1:8001,http://localhost:8000
