      "post": {
        "tags": [
          "Vernacular Voice Pipeline"
        ],
        "summary": "Vernacular Voice-to-RAG 4-Stage Bridge",
        "description": "Exposes POST /api/v1/voice/ask handling multipart/form-data.\nExecutes the 4-stage pipeline connecting citizen voice input to Constitutional RAG.",
        "operationId": "voice_ask_endpoint_api_v1_voice_ask_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_voice_ask_endpoint_api_v1_voice_ask_post"
