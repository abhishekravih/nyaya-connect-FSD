  "components": {
    "schemas": {
      "ArticleCitation": {
        "properties": {
          "article_number": {
            "type": "string",
            "title": "Article Number"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "relevance_summary": {
            "type": "string",
            "title": "Relevance Summary"
          }
        },
        "type": "object",
        "required": [
          "article_number",
          "title",
          "relevance_summary"
        ],
        "title": "ArticleCitation"
      },
      "Body_voice_ask_endpoint_api_v1_voice_ask_post": {
        "properties": {
          "audio_file": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio File",
            "description": "Audio blob recorded in browser"
          },
          "source_language": {
            "type": "string",
            "title": "Source Language",
            "description": "Language code: kn-IN, hi-IN, ta-IN, etc.",
            "default": "kn-IN"
          },
          "browser_transcript": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Browser Transcript",
            "description": "Web Speech API zero-latency fallback text"
          }
        },
        "type": "object",
        "title": "Body_voice_ask_endpoint_api_v1_voice_ask_post"
      },
      "BookingCreate": {
        "properties": {
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "lawyer_id": {
            "type": "integer",
            "title": "Lawyer Id"
          },
          "case_category": {
            "$ref": "#/components/schemas/CaseCategory"
          },
          "case_summary": {
            "type": "string",
            "minLength": 10,
            "title": "Case Summary"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "lawyer_id",
          "case_category",
          "case_summary"
        ],
        "title": "BookingCreate"
      },
      "BookingResponse": {
        "properties": {
          "booking_id": {
            "type": "integer",
            "title": "Booking Id"
          },
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "lawyer_id": {
            "type": "integer",
            "title": "Lawyer Id"
          },
          "case_category": {
            "$ref": "#/components/schemas/CaseCategory"
          },
          "case_summary": {
            "type": "string",
            "title": "Case Summary"
          },
          "total_agreed_fee": {
            "type": "string",
            "title": "Total Agreed Fee"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "milestones": {
            "items": {
              "$ref": "#/components/schemas/MilestoneResponse"
            },
            "type": "array",
            "title": "Milestones",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "booking_id",
          "user_id",
          "lawyer_id",
          "case_category",
          "case_summary",
          "total_agreed_fee"
        ],
        "title": "BookingResponse"
      },
      "CaseCategory": {
        "type": "string",
        "enum": [
          "Civil",
          "Consumer",
          "Criminal"
        ],
        "title": "CaseCategory"
      },
      "ConstitutionalArticle": {
        "properties": {
          "article_number": {
            "type": "string",
            "title": "Article Number"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "relevance_summary": {
            "type": "string",
            "title": "Relevance Summary"
          }
        },
        "type": "object",
        "required": [
          "article_number",
          "title",
          "relevance_summary"
        ],
        "title": "ConstitutionalArticle"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
