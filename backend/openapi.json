        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BookingResponse"
                  },
                  "title": "Response Get User Bookings Api V1 Bookings User  User Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
