          "Smart Milestone Bookings"
        ],
        "summary": "Get Booking",
        "description": "Fetch a single booking with its 4-stage milestones.\nProtected route: requires valid JWT bearer token.",
        "operationId": "get_booking_api_v1_bookings__booking_id__get",
