    "/api/v1/bookings/{booking_id}/milestones/{stage_no}": {
      "patch": {
        "tags": [
          "Smart Milestone Bookings"
        ],
        "summary": "Update Milestone Stage",
        "description": "Updates milestone status ('PENDING' -> 'IN_PROGRESS' -> 'COMPLETED').\nEnforces sequential stage progression: later stages cannot be marked\n'IN_PROGRESS' or 'COMPLETED' while an earlier stage is still pending.\nAudits updated_at and completed_at timestamps.\nProtected route: requires valid JWT bearer token.",
        "operationId": "update_milestone_stage_api_v1_bookings__booking_id__milestones__stage_no__patch",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "booking_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Booking Id"
            }
          },
          {
            "name": "stage_no",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Stage No"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MilestoneStatusUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MilestoneResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
