        ],
        "summary": "Get User Bookings",
        "description": "Returns all bookings placed by a specific user with ordered 4-stage milestones\nfor Person 1's /dashboard client UI.\nProtected route: requires valid JWT bearer token.",
        "operationId": "get_user_bookings_api_v1_bookings_user__user_id__get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "User Id"
            }
